# Kopioi tiedostoksi .env ja täytä arvot.

# Pakollinen: appin ja palvelimen yhteinen salaisuus (esim. `openssl rand -hex 24`).
NOSTE_TOKEN=

# MML avoin karttakuvapalvelu -avain maastokarttatiilille (ilmainen):
# https://www.maanmittauslaitos.fi/rajapinnat/api-avaimen-ohje
MML_API_KEY=

# Kelivahti-ilmoitukset ntfy:llä: asenna ntfy-appi puhelimeen, tilaa oma salainen
# aihe ja laita sen osoite tähän (esim. https://ntfy.sh/noste-kelivahti-x7k2).
#NTFY_URL=

# Valinnaiset:
#LIPAS_BASE=https://lipas.cc.jyu.fi/api   # liikuntapaikkarekisteri (uimarannat)
#PORT=8080
#MARINE_TILE_TEMPLATE=   # oletus: Traficomin avoin rasterimerikartta (WMTS)
#DATA_DIR=./data
#TILE_CACHE_DIR=./data/tiles
#TILE_CACHE_TTL=2592000
#FORECAST_CACHE_TTL=900

# Appiin sisäänrakennettu token: vain lukureitit (tiilet, ennusteet, havainnot).
CLIENT_TOKEN=

# Postgres (docker-compose.prod.yml): salasana kannalle; appi saa DATABASE_URL:n composesta.
# Ilman DATABASE_URL:ää appi käyttää PGliteä data/pglite-hakemistossa.
POSTGRES_PASSWORD=vaihda-tama

# Push-ilmoitukset (APNs). Avain: developer.apple.com → Keys → Apple Push Notifications service (APNs).
# APNS_KEY_P8 = .p8-tiedoston sisältö base64:na (base64 -i AuthKey_XXXX.p8 | tr -d '\n').
# Tyhjinä push on pois ja ilmoitukset näkyvät vain appin sisällä.
APNS_KEY_ID=
APNS_TEAM_ID=V432VU2WGN
APNS_KEY_P8=
APNS_TOPIC=com.aihiolabs.noste
